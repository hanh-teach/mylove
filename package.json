    "@types/proper-lockfile": "^4.1.4",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
